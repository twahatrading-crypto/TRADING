# TLUXE gateway (Railway service "tluxe-web": web app + API). PLACEHOLDERS ONLY - never commit real values.
# On Railway set these as service Variables (they are stored literally - no quoting needed). For a local .env,
# wrap values containing "$" (the password hash) in single quotes.

# production on Railway; development locally (defaults: 127.0.0.1:8780, localhost:5182 origins, in-memory store).
TLUXE_ENV=production
# Railway injects PORT; it always wins in production. The gateway listens on 0.0.0.0:$PORT.
# PORT=8080

# Public URLs - the real domain once chosen (https only in production). The web app and API share ONE origin.
# Defaults to https://$RAILWAY_PUBLIC_DOMAIN when unset; a bare domain (no https://) is accepted.
PUBLIC_APP_URL=https://app.example.com
API_PUBLIC_URL=https://app.example.com
# Exact https origins, comma separated. Never "*", never localhost in production.
ALLOWED_ORIGINS=https://app.example.com

# Railway PostgreSQL: reference the database service, e.g. ${{Postgres.DATABASE_URL}}. Migrations run at start-up.
DATABASE_URL=

# Owner sign-in. Generate locally:  python -m tluxe_gateway.hashpw   (prints a scrypt hash; the password is never stored)
TLUXE_OWNER_PASSWORD_HASH=
# Session lifetime (hours, default 12). Sessions rotate hourly; only SHA-256(session id) is stored.
# TLUXE_SESSION_TTL_HOURS=12

# Internal services over Railway private networking (never public). Each token is the SAME random value as the
# corresponding service's own token variable. Leave empty until the service exists -> it reports NOT CONNECTED.
# Use the port the service really listens on (a service that binds Railway's $PORT listens on that value, often 8080).
# A bare host:port is accepted; an invalid value is reported as ERROR in /api/status and never crashes the gateway.
TLUXE_AI_URL=http://tluxe-ai.railway.internal:8767
TLUXE_AI_TOKEN=
# Databento (COMEX GC / SI, GLBX.MDP3) - simplest: set ONLY this on the gateway service. The container entrypoint then
# runs the Databento bridge beside the gateway; the key goes to the bridge process only (never to the gateway, the
# browser, logs or AI). Leave TLUXE_DATABENTO_URL / TLUXE_DB_BRIDGE_TOKEN empty in that case.
DATABENTO_API_KEY=
# Optional: TLUXE_DB_PLAN=standard (trades + ohlcv-1m; default) · TLUXE_DB_CONTRACT_MODE / TLUXE_DB_CONTRACT_GC
# Alternative: a separate Databento service (bridge/databento/Dockerfile) - then set these two instead of the key:
TLUXE_DATABENTO_URL=
TLUXE_DB_BRIDGE_TOKEN=
TLUXE_NEWS_URL=http://tluxe-news.railway.internal:8768
TLUXE_NEWS_TOKEN=

# MT5 remote link from the Windows VPS: SHA-256 of TLUXE_MT5_BRIDGE_TOKEN (the gateway never stores the token itself).
# Rotation: list the new hash next to the old one, switch the VPS, then remove the old hash. Optional expiry:  <sha256>@<unix-seconds>
#   python -c "import hashlib,getpass; print(hashlib.sha256(getpass.getpass().encode()).hexdigest())"
TLUXE_MT5_BRIDGE_TOKEN_SHA256=
# IBKR COMEX price-level depth service on the VPS, polled server-side (https only). The token is a server secret:
# set it only in the Railway service variables - never in Git, never in a VITE_* / client-visible variable.
TLUXE_IBKR_DEPTH_URL=
TLUXE_IBKR_DEPTH_TOKEN=
# Older alternative - inbound IBKR depth link from the cloud Windows VPS (bridge/ibkr): sha256 of TLUXE_IBKR_BRIDGE_TOKEN only.
TLUXE_IBKR_BRIDGE_TOKEN_SHA256=

# Set by the Dockerfile (the built web bundle). Locally: ../../dist-cloud after `npm run build:cloud`.
# TLUXE_STATIC_DIR=/app/web
LOG_FORMAT=json
# LOG_LEVEL=INFO
