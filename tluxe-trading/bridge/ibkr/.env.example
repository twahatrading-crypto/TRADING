# TLUXE IBKR depth bridge - copy to .env ON THE VPS (never commit .env).
# IBKR username / password / 2FA are NEVER put here: you type them into IB Gateway itself.

# Outbound link to the TLUXE cloud gateway (Railway). wss only.
TLUXE_IBKR_GATEWAY_URL=wss://trading-production-e1d5.up.railway.app/bridge/ibkr
# 32+ random characters. Railway stores only its SHA-256 in TLUXE_IBKR_BRIDGE_TOKEN_SHA256.
TLUXE_IBKR_BRIDGE_TOKEN=
TLUXE_IBKR_BRIDGE_ID=ibkr-vps

# IB Gateway API on THIS VPS (loopback only). Live 4001, paper 4002.
TLUXE_IBKR_HOST=127.0.0.1
TLUXE_IBKR_PORT=4001
TLUXE_IBKR_CLIENT_ID=71
TLUXE_IBKR_DEPTH_ROWS=10
TLUXE_IBKR_ROOTS=GC,SI
TLUXE_IBKR_GATEWAY_PROCESS=ibgateway.exe
