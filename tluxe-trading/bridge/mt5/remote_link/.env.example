# TLUXE MT5 remote link (Windows VPS). Copy to .env in THIS folder (NEVER commit it).
# Outbound TLS WebSocket to your TLUXE cloud gateway:
TLUXE_GATEWAY_BRIDGE_URL=wss://YOUR-TLUXE-DOMAIN/bridge/mt5
# Remote bridge credential (>= 32 random chars). The cloud stores only its SHA-256 in TLUXE_MT5_BRIDGE_TOKEN_SHA256.
#   py -c "import secrets; print(secrets.token_urlsafe(32))"
#   py -c "import hashlib,getpass; print(hashlib.sha256(getpass.getpass().encode()).hexdigest())"   (paste the token; not echoed, not in history)
TLUXE_MT5_BRIDGE_TOKEN=
# Name shown in TLUXE status.
TLUXE_BRIDGE_ID=mt5-vps
# The local MT5 bridge (loopback only). Its TLUXE_BRIDGE_TOKEN is read from ..\.env automatically.
TLUXE_LOCAL_BRIDGE_URL=http://127.0.0.1:8765
