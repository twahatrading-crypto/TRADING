# Trading by TLUXE - MT5 bridge configuration. Copy to .env (never commit .env).
# REQUIRED: random secret, >= 32 chars:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TLUXE_BRIDGE_TOKEN=
# Bind address (default: local only). Use a private LAN address only if needed.
TLUXE_BRIDGE_HOST=127.0.0.1
TLUXE_BRIDGE_PORT=8765
# Comma-separated browser origins allowed to call the bridge.
TLUXE_BRIDGE_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:4180,http://127.0.0.1:4180
# Broker trade-server timezone (IANA). Strongly recommended, e.g. Europe/Athens, Asia/Nicosia, UTC.
TLUXE_MT5_SERVER_TIMEZONE=
# Optional: path to terminal64.exe if several terminals are installed.
TLUXE_MT5_TERMINAL_PATH=
# Optional: only if the terminal is not already logged in. Leave empty to use the running terminal's session.
TLUXE_MT5_LOGIN=
TLUXE_MT5_PASSWORD=
TLUXE_MT5_SERVER=
# Max bars per history request.
TLUXE_BRIDGE_MAX_BARS=50000
