# Trading by TLUXE - News backend. Copy to .env in THIS folder (NEVER commit .env).
# Trading Economics API credential "client:secret" (server-side ONLY - never in the browser, chat, logs or Git).
# Left empty, the backend starts and every feed reports NOT CONNECTED (the page shows DATA UNAVAILABLE).
TRADING_ECONOMICS_API_KEY=
# REQUIRED: random secret the TLUXE browser app uses to talk to THIS backend (>= 32 chars, NOT a provider key):
#   py -c "import secrets; print(secrets.token_urlsafe(32))"
TLUXE_NEWS_TOKEN=
# Bind address (local only) and dedicated port (MT5 8765 · Databento 8766 · TLUXE AI 8767 · News 8768).
TLUXE_NEWS_HOST=127.0.0.1
TLUXE_NEWS_PORT=8768
TLUXE_NEWS_ALLOWED_ORIGINS=http://localhost:5182,http://127.0.0.1:5182,http://localhost:5181,http://127.0.0.1:5181,http://localhost:4181,http://127.0.0.1:4181
# Economic calendar (Trading Economics). Countries use Trading Economics names, comma-separated.
TE_CALENDAR_ENABLED=1
TE_CALENDAR_COUNTRIES=united states,euro area,united kingdom,canada,japan,china,switzerland,australia,germany
# Calendar window: days back / days ahead of today (UTC).
TE_CALENDAR_DAYS_BACK=1
TE_CALENDAR_DAYS_AHEAD=7
# Streaming (Trading Economics websocket, only if your plan includes it): auto = try, detect entitlement, fall back to REST.
TE_STREAMING=auto
# Bounded REST refresh (seconds): full calendar window / recent updates (fast only around MEDIUM/HIGH releases).
TE_CALENDAR_REFRESH_S=900
TE_UPDATES_REFRESH_S=300
TE_UPDATES_FAST_S=60
# Macro news (Trading Economics News API - only if your plan includes it).
TE_NEWS_ENABLED=0
TE_NEWS_REFRESH_S=300
# Breaking news: no licensed provider is configured yet (adapter interface only). Leave empty.
TLUXE_BREAKING_PROVIDER=
