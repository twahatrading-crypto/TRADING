# TLUXE HLR link - copy to .env and fill in. NEVER commit .env (it is git-ignored).
#
# The link runs on the trading PC. It dials OUT to the gateway and answers read-only GET requests by
# reading services that are ALREADY RUNNING on this machine, over loopback. It opens no MT5
# connection, no IBKR client, no collector, no runner and no mailer.

# The gateway's bridge endpoint. Must be wss:// - the link never sends data in clear text.
TLUXE_HLR_GATEWAY_URL=wss://twahatrading.com/bridge/hlr

# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Put the SHA-256 of this value in Railway as TLUXE_HLR_BRIDGE_TOKEN_SHA256:
#   python -c "import hashlib;print(hashlib.sha256(open('tok.txt','rb').read().strip()).hexdigest())"
# The cloud only ever stores the hash. This plaintext stays on this PC.
TLUXE_HLR_BRIDGE_TOKEN=

# Identifies this machine in the gateway's audit log. 1-64 of letters, digits, . _ -
TLUXE_HLR_BRIDGE_ID=hlr-pc

# Local services to read. All MUST be loopback; the link refuses anything else, so these services
# are never exposed. Defaults match the standard HLR install - override only if yours differ.
#TLUXE_HLR_MT5_URL=http://127.0.0.1:8123
#TLUXE_HLR_GC_URL=http://127.0.0.1:8261
#TLUXE_HLR_TRACKER_URL=http://127.0.0.1:8127
