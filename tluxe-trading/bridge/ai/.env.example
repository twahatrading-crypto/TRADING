# Trading by TLUXE - TLUXE AI backend. Copy to .env in THIS folder (NEVER commit .env).
# OpenAI API key: server-side ONLY. Never paste it into the browser, chat, source files, logs or Git.
# Left empty, the backend still starts and reports "Not Connected" (NOT_CONFIGURED).
OPENAI_API_KEY=
# REQUIRED: random secret the TLUXE browser app uses to talk to THIS backend (>= 32 chars, NOT the OpenAI key):
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(32))"
TLUXE_AI_TOKEN=
# Model used for Chat (selected server-side; the browser cannot change it).
TLUXE_AI_MODEL=gpt-5.5
# Bind address (local only) and dedicated port (MT5 bridge 8765, Databento bridge 8766, TLUXE AI 8767).
TLUXE_AI_HOST=127.0.0.1
TLUXE_AI_PORT=8767
# Browser origins allowed to call the backend (exact match; never "*").
TLUXE_AI_ALLOWED_ORIGINS=http://localhost:5182,http://127.0.0.1:5182,http://localhost:5181,http://127.0.0.1:5181,http://localhost:4181,http://127.0.0.1:4181
# OpenAI request timeout (seconds) and maximum answer length (output tokens).
TLUXE_AI_TIMEOUT_S=60
TLUXE_AI_MAX_OUTPUT_TOKENS=2000
