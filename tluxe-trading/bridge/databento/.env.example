# Trading by TLUXE - Databento market-data bridge. Copy to .env (NEVER commit .env).
# REQUIRED: your Databento API key (server-side only; never paste it into the browser, chat or source files).
DATABENTO_API_KEY=
# REQUIRED: random secret the TLUXE browser app uses to talk to THIS bridge (>= 32 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TLUXE_DB_BRIDGE_TOKEN=
# Bind address (default: local only) and port.
TLUXE_DB_BRIDGE_HOST=127.0.0.1
TLUXE_DB_BRIDGE_PORT=8766
# Comma-separated browser origins allowed to call the bridge.
TLUXE_DB_BRIDGE_ALLOWED_ORIGINS=http://localhost:5181,http://127.0.0.1:5181,http://localhost:4181,http://127.0.0.1:4181
# Contract selection: auto = Databento continuous volume-leader (GC.v.0 / SI.v.0, actual contract always reported);
# manual = the raw contracts below (e.g. GCZ6 / SIZ6).
TLUXE_DB_CONTRACT_MODE=auto
TLUXE_DB_CONTRACT_GC=
TLUXE_DB_CONTRACT_SI=
# Retention (bounded memory) and publishing.
TLUXE_DB_MAX_TRADES=100000
TLUXE_DB_MAX_FRAMES=1200
TLUXE_DB_PUBLISH_MS=250
TLUXE_DB_REPLAY_HOURS=24
